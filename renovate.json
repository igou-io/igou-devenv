{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>igou-io/igou-devenv//renovate-base.json"
  ],
  "customDatasources": {
    "cursor-agent": {
      "defaultRegistryUrlTemplate": "https://cursor.com/install",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": [releases[$contains(version, 'DOWNLOAD_URL=')].{ \"version\": $match(version, /downloads\\.cursor\\.com\\/lab\\/([^/]+)/).groups[0], \"releaseTimestamp\": $join($split($substring($match(version, /downloads\\.cursor\\.com\\/lab\\/([^/]+)/).groups[0], 0, 10), '.'), '-') & 'T00:00:00Z' }] }"
      ]
    }
  },
  "packageRules": [
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "websockets"
      ],
      "description": "ansible-rulebook (same requirements.txt) pins websockets<15.1; without this cap the python-dependencies group PR arrives permanently red on pip ResolutionImpossible. Lift when ansible-rulebook widens its range.",
      "allowedVersions": "<15.1"
    },
    {
      "matchManagers": [
        "pip_requirements"
      ],
      "matchFileNames": [
        ".devcontainer/omnigent/**"
      ],
      "groupName": "omnigent runtime",
      "automerge": false,
      "description": "Review compatibility with the deployed server and the tested OpenShell WebSocket proxy override before updating."
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "groupName": "container base images"
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "quay.io/centos/centos"
      ],
      "pinDigests": false
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "groupName": "cli tools"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "groupName": "npm dependencies"
    },
    {
      "matchManagers": [
        "mise",
        "custom.regex"
      ],
      "groupName": "mise-managed cli tools",
      "description": "The native mise manager and HTTP regex manager share the lockfile handoff; release-prepare regenerates mise.lock before enabling GitHub auto-merge.",
      "automerge": false,
      "matchFileNames": [
        "mise.toml"
      ]
    },
    {
      "matchManagers": [
        "mise"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "description": "Lock-file-maintenance PRs only refresh mise.lock (no mise.toml bump), so release-prepare never touches them; they are safe to automerge behind the required build check.",
      "automerge": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "anthropics/claude-code"
      ],
      "groupName": "claude code",
      "description": "Coding-agent harness, ungrouped from the SHA-pinned agent CLIs: the Dockerfile verifies it via PGP against the release signature (no *_SHA256_* ARGs), so a version bump is self-contained and safe to automerge on a green build. 3-day age gate instead of the global 10: harness releases ship protocol/feature fixes weekly and staleness has real operational cost on the Hermes terminal backend.",
      "minimumReleaseAge": "3 days",
      "schedule": [
        "at any time"
      ],
      "automerge": true
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "anomalyco/opencode",
        "cursor-agent",
        "openai/codex"
      ],
      "groupName": "coding agent clis",
      "description": "CLI SHA preparation owns merging this group. Its generated-artifact author is recognized by gitIgnoredAuthors so Renovate can refresh prepared branches; human edits still freeze them. Cursor/OpenCode retain their 3-day gate and Codex is exempted separately.",
      "minimumReleaseAge": "3 days",
      "schedule": [
        "at any time"
      ],
      "automerge": false
    },
    {
      "description": "Codex releases are time-sensitive; bypass the age gate while retaining checksum recapture and required CI.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "openai/codex"
      ],
      "minimumReleaseAge": null
    },
    {
      "description": "t3 releases are time-sensitive; bypass the age gate while retaining the mise lockfile handoff and required CI.",
      "matchManagers": [
        "mise"
      ],
      "matchPackageNames": [
        "t3",
        "npm:t3"
      ],
      "minimumReleaseAge": null,
      "schedule": [
        "at any time"
      ]
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "jdx/mise"
      ],
      "groupName": "mise itself (trust anchor)"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "aquaproj/aqua-registry"
      ],
      "groupName": "aqua-registry SHA pin (trust anchor)",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Update pinned versions in shell scripts and Dockerfiles via '# renovate:' comments",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.sh$/",
        "/Dockerfile$/",
        "/Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?(?: versioning=(?<versioning>\\S+))?\\n(?:ARG )?\\w+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      "description": "Track annotated HTTP tools skipped by the native mise manager",
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\[tools\\.\"http:[^\"\\n]+\"\\]\\nversion = \"(?<currentValue>[^\"\\n]+)\""
      ],
      "versioningTemplate": "semver"
    },
    {
      "description": "Update the aqua registry release tag and immutable commit together",
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>aquaproj/aqua-registry)\\nregistry_url = \"https://raw\\.githubusercontent\\.com/aquaproj/aqua-registry/(?<currentDigest>[a-f0-9]{40})/registry\\.yaml\" # (?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "versioningTemplate": "semver",
      "autoReplaceStringTemplate": "# renovate: datasource={{{datasource}}} depName={{{depName}}}\nregistry_url = \"https://raw.githubusercontent.com/aquaproj/aqua-registry/{{{newDigest}}}/registry.yaml\" # {{{newValue}}}"
    }
  ],
  "gitIgnoredAuthors": [
    "dependency-preparation@igou-devenv.invalid",
    "41898282+github-actions[bot]@users.noreply.github.com"
  ]
}
