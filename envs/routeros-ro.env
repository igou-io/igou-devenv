# Read-only RouterOS API access on every managed device (rb5009, crs310,
# crs317, crs328). Uses the mktxp exporter identity: group policy `read,api`
# only (no ssh/write/rest-api), api-ssl on 8729. Query with
#   ansible -m community.routeros.api -a "path=system/resource" ... or
#   python librouteros; see the scope note in scoped sessions.
ROUTEROS_USERNAME=op://lab_routeros/mktxp-exporter/username
ROUTEROS_PASSWORD=op://lab_routeros/mktxp-exporter/password
ROUTEROS_API_PORT=8729
ROUTEROS_HOSTS=rb5009.igou.systems,crs310.igou.systems,crs317.igou.systems,crs328.igou.systems
PERMISSIONS=readonly
