# Read-only TrueNAS access: user agent-ro / privilege agent-readonly
# (READONLY_ADMIN; igou-inventory group_vars/truenas.yml). TrueNAS 25.x only
# authorises READONLY_ADMIN keys on the JSON-RPC WebSocket API (/api/current);
# the legacy REST /api/v2.0 answers 403 for anything but FULL_ADMIN.
#   wss://truenas.igou.systems/api/current  ->  auth.login_with_api_key [KEY]
#   then e.g. system.info, pool.dataset.query (python `websockets`).
TRUENAS_URL=https://truenas.igou.systems
TRUENAS_WS_URL=wss://truenas.igou.systems/api/current
TRUENAS_API_KEY=op://lab_truenas/agent-ro-api/api_key
PERMISSIONS=readonly
