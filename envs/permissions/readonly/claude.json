{
  "permissions": {
    "allow": [
      "Bash(oc get*)",
      "Bash(oc describe*)",
      "Bash(oc logs*)",
      "Bash(oc whoami*)",
      "Bash(oc explain*)",
      "Bash(oc version*)",
      "Bash(oc api-resources*)",
      "Bash(oc status*)",
      "Bash(kubectl get*)",
      "Bash(kubectl describe*)",
      "Bash(kubectl logs*)",
      "Bash(kubectl explain*)",
      "Bash(kubectl version*)",
      "Bash(argocd app get*)",
      "Bash(argocd app list*)",
      "Bash(argocd app diff*)",
      "Bash(helm list*)",
      "Bash(helm get*)",
      "Bash(helm template*)"
    ],
    "deny": [
      "Bash(oc apply*)",
      "Bash(oc patch*)",
      "Bash(oc delete*)",
      "Bash(oc scale*)",
      "Bash(oc rollout*)",
      "Bash(oc edit*)",
      "Bash(oc create*)",
      "Bash(oc replace*)",
      "Bash(oc adm*)",
      "Bash(oc annotate*)",
      "Bash(oc label*)",
      "Bash(oc set *)",
      "Bash(oc debug*)",
      "Bash(oc exec*)",
      "Bash(oc rsh*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl scale*)",
      "Bash(kubectl rollout*)",
      "Bash(kubectl edit*)",
      "Bash(kubectl create*)",
      "Bash(kubectl replace*)",
      "Bash(kubectl annotate*)",
      "Bash(kubectl label*)",
      "Bash(kubectl set *)",
      "Bash(kubectl exec*)",
      "Bash(argocd app sync*)",
      "Bash(argocd app delete*)",
      "Bash(argocd app set*)",
      "Bash(virtctl start*)",
      "Bash(virtctl stop*)",
      "Bash(virtctl restart*)",
      "Bash(ansible-navigator run*)",
      "Bash(ansible-playbook*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "api.anthropic.com",
        "claude.ai",
        "statsig.anthropic.com",
        "sentry.io",
        "github.com",
        "api.ocp.igou.systems",
        "cm3588-nas-01.igou.systems",
        "truenas.igou.systems",
        "rb5009.igou.systems",
        "crs310.igou.systems",
        "crs317.igou.systems",
        "crs328.igou.systems"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "."
      ],
      "denyWrite": [
        "~/.local/bin",
        "~/.bashrc",
        "~/.profile",
        "~/.bash_profile"
      ]
    },
    "enableWeakerNestedSandbox": true,
    "seccomp": {
      "applyPath": "/usr/local/lib/claude-sandbox/apply-seccomp"
    }
  }
}
