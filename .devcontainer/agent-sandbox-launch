#!/usr/bin/env bash
# shellcheck disable=SC2016,SC2054,SC2317
# Launch an agent CLI (claude, codex or opencode) inside a hardened rootless
# podman container with a FIXED credential scope: one or more envs/*.env
# profiles resolved on the host by bin/resolve-profile and injected as env
# vars / read-only mounts. The container never sees ~/.config/op, so the
# session cannot escalate beyond the profiles it was launched with.
# See adr/0006-scoped-agent-sessions.md.
#
# t3 uses this as a provider instance's binaryPath and selects the scope via
# the instance's environment (AGENT_SANDBOX_PROFILES). Every argument t3
# passes is forwarded verbatim to the agent binary inside the container:
#   claude   — spawned by the Claude Agent SDK over stdio  (podman run -i)
#   codex    — `codex app-server` over stdio               (podman run -i)
#   opencode — `opencode serve` HTTP server                (--network=host)
# All diagnostics go to stderr; stdout belongs to the agent protocol.
#
# Usage:
#   agent-sandbox-launch [--driver claude|codex|opencode] [--profiles a,b]
#                        [--dry-run] [--shell] [--] <agent args...>
#   agent-sandbox-launch --install-shim PROFILE   # write ~/.local/bin/agent-sandbox-launch-PROFILE
#
# Env (t3 instance `environment` or shell):
#   AGENT_SANDBOX_DRIVER     claude|codex|opencode (default: inferred from the
#                            first forwarded arg — app-server→codex, serve→opencode, else claude)
#   AGENT_SANDBOX_PROFILES   comma-separated envs/*.env names, later wins ("none" = no creds)
#   AGENT_SANDBOX_IMAGE      override image (default ghcr.io/igou-io/<claude-code|codex|opencode>:latest)
#   AGENT_SANDBOX_ENVDIR     env-file catalog (default /workspace/igou-devenv/envs)
#   AGENT_SANDBOX_PERMDIR    permission fragments (default <ENVDIR>/permissions)
#   AGENT_SANDBOX_WORKSPACE  mount (default /workspace)
#   AGENT_SANDBOX_SSH_TTL    lifetime of SSH keys in the in-container agent (default 12h)
#
# Profile keys interpreted here (see bin/resolve-profile for the rest):
#   SSH_KEYS=item1,item2   1Password lab_ssh items loaded into a PER-SESSION
#                          ssh-agent inside the container (host agent never mounted)
#   PERMISSIONS=readonly|guarded   per-driver tool-permission layer from
#                          envs/permissions/<level>/{claude.json,codex.toml,opencode.json}
set -euo pipefail

log() { echo "agent-sandbox-launch: $*" >&2; }

SELF="$(readlink -f "$0")"
HERE="$(dirname "$SELF")"
DRIVER="${AGENT_SANDBOX_DRIVER:-}"
PROFILES_CSV="${AGENT_SANDBOX_PROFILES:-none}"
ENVDIR="${AGENT_SANDBOX_ENVDIR:-/workspace/igou-devenv/envs}"
PERMDIR="${AGENT_SANDBOX_PERMDIR:-${ENVDIR}/permissions}"
WORKSPACE_MOUNT="${AGENT_SANDBOX_WORKSPACE:-/workspace}"
SSH_TTL="${AGENT_SANDBOX_SSH_TTL:-12h}"
DRY_RUN=false
SHELL_MODE=false
INSTALL_SHIM=""

AGENT_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --driver)   DRIVER="$2"; shift 2 ;;
        --profiles) PROFILES_CSV="$2"; shift 2 ;;
        --dry-run)  DRY_RUN=true; shift ;;
        --shell)    SHELL_MODE=true; shift ;;
        --install-shim) INSTALL_SHIM="$2"; shift 2 ;;
        --) shift; AGENT_ARGS+=("$@"); break ;;
        *)  AGENT_ARGS+=("$1"); shift ;;
    esac
done

# ---------------------------------------------------------------------------
# --install-shim: opencode instances need one binaryPath per profile because
# t3 keeps a single shared `opencode serve` per binaryPath (claude/codex select
# by env and don't need this).
# ---------------------------------------------------------------------------
if [ -n "$INSTALL_SHIM" ]; then
    shimdir="${AGENT_SANDBOX_SHIM_DIR:-$HOME/.local/bin}"
    shim="${shimdir}/agent-sandbox-launch-${INSTALL_SHIM}"
    mkdir -p "$shimdir"
    cat > "$shim" << SHIM
#!/usr/bin/env bash
# Generated by agent-sandbox-launch --install-shim: fixed profile for a t3 instance.
export AGENT_SANDBOX_PROFILES="${INSTALL_SHIM}"
exec "${SELF}" "\$@"
SHIM
    chmod +x "$shim"
    log "wrote $shim"
    exit 0
fi

# ---------------------------------------------------------------------------
# Driver
# ---------------------------------------------------------------------------
if [ -z "$DRIVER" ]; then
    case "${AGENT_ARGS[0]:-}" in
        app-server) DRIVER=codex ;;
        serve)      DRIVER=opencode ;;
        *)          DRIVER=claude ;;
    esac
fi
case "$DRIVER" in
    claude)   IMAGE_DEFAULT="ghcr.io/igou-io/claude-code:latest"; BIN=claude ;;
    codex)    IMAGE_DEFAULT="ghcr.io/igou-io/codex:latest";       BIN=codex ;;
    opencode) IMAGE_DEFAULT="ghcr.io/igou-io/opencode:latest";    BIN=opencode ;;
    *) log "unknown driver '$DRIVER' (claude|codex|opencode)"; exit 1 ;;
esac
IMAGE="${AGENT_SANDBOX_IMAGE:-$IMAGE_DEFAULT}"

# ---------------------------------------------------------------------------
# Resolve profiles on the host (op never enters the container)
# ---------------------------------------------------------------------------
resolve_profile_bin() {
    if [ -n "${RESOLVE_PROFILE:-}" ]; then echo "$RESOLVE_PROFILE"; return; fi
    local c
    for c in "$HERE/resolve-profile" "$HERE/../bin/resolve-profile" /workspace/igou-devenv/bin/resolve-profile; do
        [ -x "$c" ] && { echo "$c"; return; }
    done
    command -v resolve-profile
}

ENV_ARGS=()
TMPPATHS=()
MOUNT_KUBE=""
MOUNT_AUTH=""
SSH_KEYS=""
PERMISSIONS=""
PROFILES=()
cleanup() { for p in "${TMPPATHS[@]:-}"; do [ -n "$p" ] && rm -rf "$p"; done; }
trap cleanup EXIT

if [ "$PROFILES_CSV" != "none" ] && [ -n "$PROFILES_CSV" ]; then
    IFS=, read -r -a PROFILES <<< "$PROFILES_CSV"
    RESOLVER=$(resolve_profile_bin) || { log "resolve-profile not found"; exit 1; }
    if ! resolved=$(IGOU_ENVDIR="$ENVDIR" "$RESOLVER" "${PROFILES[@]}" 2> >(sed 's/^/agent-sandbox-launch: /' >&2)); then
        exit 1
    fi
    while IFS= read -r line; do
        [ -z "$line" ] && continue
        case "$line" in
            KUBECONFIG=*)
                MOUNT_KUBE="${line#KUBECONFIG=}"; TMPPATHS+=("$MOUNT_KUBE")
                ENV_ARGS+=("-e" "KUBECONFIG=/tmp/kubeconfig") ;;
            REGISTRY_AUTH_FILE=*)
                ENV_ARGS+=("-e" "REGISTRY_AUTH_FILE=/tmp/registry-auth/config.json") ;;
            DOCKER_CONFIG=*)
                MOUNT_AUTH="${line#DOCKER_CONFIG=}"; TMPPATHS+=("$MOUNT_AUTH")
                ENV_ARGS+=("-e" "DOCKER_CONFIG=/tmp/registry-auth") ;;
            SSH_KEYS=*)    SSH_KEYS="${line#SSH_KEYS=}" ;;
            PERMISSIONS=*) PERMISSIONS="${line#PERMISSIONS=}" ;;
            *) ENV_ARGS+=("-e" "$line") ;;
        esac
    done <<< "$resolved"
fi
SCOPE="${PROFILES_CSV}"
SCOPE_SLUG="${SCOPE//,/-}"

# ---------------------------------------------------------------------------
# Scope note: the agent must know what identity it has and that there is no
# way to get more from inside the session.
# ---------------------------------------------------------------------------
scope_note() {
    cat << NOTE
# Session scope: ${SCOPE}

This session runs in a sandbox with a FIXED credential scope: profile(s)
\`${SCOPE}\` from igou-devenv \`envs/\`${PERMISSIONS:+, permission level \`${PERMISSIONS}\`}.
- \`KUBECONFIG\`, registry auth and any other credentials are already set; \`oc\`/\`kubectl\`
  just work for exactly this identity. Check it with \`oc whoami\`.
- There is NO \`use\`, \`ssh-use\`, \`op\`, or 1Password here. Do not look for them or try
  to work around a 403: the scope is a deliberate policy boundary.
- If a task needs a different or broader identity, stop and say which profile
  (e.g. \`ocp-cluster-edit\`, \`rk8s\`) a new session should be started with.
NOTE
    [ -n "$SSH_KEYS" ] && echo "- SSH keys loaded in this session's private agent: \`${SSH_KEYS}\`."
    return 0
}

merge_json() { # base-file fragment-file -> stdout (fragment wins, deep merge)
    if [ -s "$1" ]; then jq -s '.[0] * .[1]' "$1" "$2"; else cat "$2"; fi
}

perm_file() { # driver-file-name -> path (empty when no PERMISSIONS); rc 1 = fail closed
    [ -n "$PERMISSIONS" ] || return 0
    local f="${PERMDIR}/${PERMISSIONS}/$1"
    if [ ! -f "$f" ]; then log "permission level '${PERMISSIONS}' has no $1 in ${PERMDIR}"; return 1; fi
    echo "$f"
}

# ---------------------------------------------------------------------------
# Per-driver home isolation: history/auth/config stay per scope. "none" keeps
# the shared default homes (same as bin/*-run with no -e).
# ---------------------------------------------------------------------------
HOME_ARGS=()
CRED_SEEDED=""
case "$DRIVER" in
    claude)
        if [ "$SCOPE" = "none" ]; then CLAUDE_HOME="$HOME/.claude"; else CLAUDE_HOME="$HOME/.claude-${SCOPE_SLUG}"; fi
        mkdir -p "$CLAUDE_HOME"
        # ~/.claude.json is not bind-mounted (atomic rewrites break file mounts);
        # the image entrypoint seeds it from this snapshot.
        [ -f "$HOME/.claude.json" ] && cp "$HOME/.claude.json" "$CLAUDE_HOME/.claude-state.json"
        if [ "$SCOPE" != "none" ]; then
            # Claude Max OAuth lives in ~/.claude/.credentials.json; seed the
            # per-scope home from it (refreshed tokens are copied back on exit,
            # see the end of this script) so scoped sessions are logged in.
            if [ -f "$HOME/.claude/.credentials.json" ]; then
                cp "$HOME/.claude/.credentials.json" "$CLAUDE_HOME/.credentials.json"
                chmod 600 "$CLAUDE_HOME/.credentials.json"
                CRED_SEEDED="$CLAUDE_HOME/.credentials.json"
            fi
            { scope_note; [ -s "$HOME/.claude/CLAUDE.md" ] && { echo; cat "$HOME/.claude/CLAUDE.md"; }; } > "$CLAUDE_HOME/CLAUDE.md"
            pf=$(perm_file claude.json) || exit 1
            if [ -n "$pf" ]; then
                merge_json "$HOME/.claude/settings.json" "$pf" > "$CLAUDE_HOME/settings.json"
            elif [ -f "$HOME/.claude/settings.json" ] && [ ! -f "$CLAUDE_HOME/settings.json" ]; then
                cp "$HOME/.claude/settings.json" "$CLAUDE_HOME/settings.json"
            fi
        fi
        HOME_ARGS+=(-v "$CLAUDE_HOME:/home/igou/.claude:Z")
        ;;
    codex)
        if [ "$SCOPE" = "none" ]; then CODEX_HOME_DIR="$HOME/.codex"; else CODEX_HOME_DIR="$HOME/.codex-${SCOPE_SLUG}"; fi
        mkdir -p "$CODEX_HOME_DIR"
        if [ "$SCOPE" != "none" ]; then
            # auth only; sqlite state/history stay per scope by not being copied
            [ -f "$HOME/.codex/auth.json" ] && cp "$HOME/.codex/auth.json" "$CODEX_HOME_DIR/auth.json"
            pf=$(perm_file codex.toml) || exit 1
            { [ -f "$HOME/.codex/config.toml" ] && cat "$HOME/.codex/config.toml"
              if [ -n "$pf" ]; then echo; echo "# --- permission level: ${PERMISSIONS} (agent-sandbox-launch) ---"; cat "$pf"; fi
              true
            } > "$CODEX_HOME_DIR/config.toml"
            { scope_note; [ -s "$HOME/.codex/AGENTS.md" ] && { echo; cat "$HOME/.codex/AGENTS.md"; }; } > "$CODEX_HOME_DIR/AGENTS.md"
        fi
        HOME_ARGS+=(-v "$CODEX_HOME_DIR:/home/igou/.codex:Z" -e CODEX_HOME=/home/igou/.codex)
        ;;
    opencode)
        OPENCODE_CONFIG="${OPENCODE_CONFIG:-$HOME/.config/opencode}"
        OPENCODE_STATE="${OPENCODE_STATE:-$HOME/.local/share/opencode}"
        mkdir -p "$OPENCODE_CONFIG" "$OPENCODE_STATE"
        HOME_ARGS+=(-v "$OPENCODE_CONFIG:/home/igou/.config/opencode:Z" -v "$OPENCODE_STATE:/home/igou/.local/share/opencode:Z")
        if [ "$SCOPE" != "none" ]; then
            # opencode has no per-scope home; the scope note rides in as an extra
            # instructions file and the permission layer via OPENCODE_CONFIG_CONTENT.
            note=$(mktemp /tmp/agent-scope.XXXXXX); TMPPATHS+=("$note")
            scope_note > "$note"
            HOME_ARGS+=(-v "$note:/etc/agent/scope.md:ro,Z")
            cfg='{"instructions":["/etc/agent/scope.md"]}'
            pf=$(perm_file opencode.json) || exit 1
            if [ -n "$pf" ]; then
                cfg=$(jq -c -s '.[0] * .[1]' <(echo "$cfg") "$pf")
            fi
            HOME_ARGS+=(-e "OPENCODE_CONFIG_CONTENT=${cfg}")
        fi
        ;;
esac

# ---------------------------------------------------------------------------
# SSH keys: read on the host, mounted read-only for the session, loaded into
# an ssh-agent that lives and dies with the container.
# ---------------------------------------------------------------------------
SSH_ARGS=()
if [ -n "$SSH_KEYS" ]; then
    keydir=$(mktemp -d /tmp/agent-ssh-keys.XXXXXX); TMPPATHS+=("$keydir")
    IFS=, read -r -a items <<< "$SSH_KEYS"
    for item in "${items[@]}"; do
        if ! op read "op://${SSH_USE_VAULT:-lab_ssh}/${item}/private key?ssh-format=openssh" > "$keydir/$item" 2>/dev/null; then
            log "failed to read SSH key '${item}' from 1Password"; exit 1
        fi
        chmod 600 "$keydir/$item"
    done
    SSH_ARGS+=(-v "$keydir:/tmp/agent-ssh-keys:ro,Z" -e "AGENT_SANDBOX_SSH_TTL=${SSH_TTL}")
fi

# ---------------------------------------------------------------------------
# Hardened podman run (mirrors bin/*-run and the former opencode-sandbox-launch)
# ---------------------------------------------------------------------------
RUN_ARGS=(
    --rm
    --userns=keep-id
    --cap-drop=ALL
    --security-opt no-new-privileges:true
    --tmpfs /tmp:rw,noexec,nosuid,size=256m
    --tmpfs /run:rw,noexec,nosuid,size=64m
    --cpus=2
    --pids-limit=512
    --ulimit nofile=1024:2048
    --ulimit nproc=512:512
    --ulimit core=0
)
if command -v catatonit &>/dev/null || [ -x /usr/libexec/podman/catatonit ]; then
    RUN_ARGS+=(--init)
fi
# Host networking for every driver: opencode's `serve` must be reachable by t3
# at the 127.0.0.1:PORT it prints, and t3 hands claude/codex an MCP endpoint on
# 127.0.0.1:3773 (the t3-code preview tools) that must resolve to the host too.
# Isolation still comes from cap-drop/userns/no-new-privileges and the absence
# of ~/.config/op, not from the network namespace.
RUN_ARGS+=(--network=host)
case "$DRIVER" in
    opencode)
        # One shared server per binaryPath; a fixed name so a restart replaces it.
        RUN_ARGS+=(--replace --name "opencode-instance-${SCOPE_SLUG}") ;;
    *)
        # stdio protocol; several sessions of one instance may run at once.
        if $SHELL_MODE; then RUN_ARGS+=(-it); else RUN_ARGS+=(-i); fi ;;
esac
$SHELL_MODE && [ "$DRIVER" = opencode ] && RUN_ARGS+=(-it)

# Workspace at the same absolute path so path-keyed project state matches
# devcontainer sessions. NO ~/.config/op mount — that is the point.
RUN_ARGS+=(-v "${WORKSPACE_MOUNT}:${WORKSPACE_MOUNT}:Z" -w "${WORKSPACE_MOUNT}")
# t3 passes `--add-dir ~/.t3/userdata/attachments` (pasted files) to claude;
# the path must exist in the container or the CLI refuses to start.
T3_ATTACH="${AGENT_SANDBOX_T3_ATTACHMENTS:-$HOME/.t3/userdata/attachments}"
[ -d "$T3_ATTACH" ] && RUN_ARGS+=(-v "$T3_ATTACH:$T3_ATTACH:ro,Z")
RUN_ARGS+=("${HOME_ARGS[@]}")
[ -n "$MOUNT_KUBE" ] && RUN_ARGS+=(-v "$MOUNT_KUBE:/tmp/kubeconfig:ro,Z")
[ -n "$MOUNT_AUTH" ] && RUN_ARGS+=(-v "$MOUNT_AUTH:/tmp/registry-auth:ro,Z")
[ ${#SSH_ARGS[@]} -gt 0 ] && RUN_ARGS+=("${SSH_ARGS[@]}")
RUN_ARGS+=(-e "AGENT_PROFILE=${SCOPE}" -e "AGENT_SANDBOX_DRIVER=${DRIVER}")
[ ${#ENV_ARGS[@]} -gt 0 ] && RUN_ARGS+=("${ENV_ARGS[@]}")

if $SHELL_MODE; then
    INNER=(bash)
else
    INNER=("$BIN" "${AGENT_ARGS[@]}")
fi
if [ -n "$SSH_KEYS" ]; then
    # Start the per-session agent, load the mounted keys, then exec the agent
    # binary with stdio untouched (agent/ssh-add output to stderr only).
    CMD=("$IMAGE" bash -c 'eval "$(ssh-agent -s)" >/dev/null 2>&1; for k in /tmp/agent-ssh-keys/*; do ssh-add -t "${AGENT_SANDBOX_SSH_TTL:-12h}" "$k" >&2 2>/dev/null; done; exec "$@"' bash "${INNER[@]}")
else
    CMD=("$IMAGE" "${INNER[@]}")
fi

if $DRY_RUN; then
    printf "podman run"
    printf " %q" "${RUN_ARGS[@]}"
    printf " %q" "${CMD[@]}"
    echo
    exit 0
fi

if ! podman image exists "$IMAGE" 2>/dev/null; then
    log "pulling $IMAGE ..."
    podman pull "$IMAGE" >&2 || { log "failed to pull $IMAGE"; exit 1; }
fi

podman run "${RUN_ARGS[@]}" "${CMD[@]}"
rc=$?
# A scoped session may have refreshed the OAuth token; propagate it back so the
# real home (and the next scoped session) keep working. Newer file wins.
if [ -n "$CRED_SEEDED" ] && [ "$CRED_SEEDED" -nt "$HOME/.claude/.credentials.json" ]; then
    cp "$CRED_SEEDED" "$HOME/.claude/.credentials.json"
    chmod 600 "$HOME/.claude/.credentials.json"
fi
exit "$rc"
