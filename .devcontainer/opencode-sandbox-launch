#!/usr/bin/env bash
# Back-compat shim: the opencode t3 provider instance historically pointed its
# binaryPath here (adr/0005). The launcher is now driver-agnostic —
# agent-sandbox-launch (adr/0006) — and this just maps the old env names.
#   OPENCODE_SANDBOX_PROFILE   -> AGENT_SANDBOX_PROFILES
#   OPENCODE_SANDBOX_IMAGE     -> AGENT_SANDBOX_IMAGE
#   OPENCODE_SANDBOX_ENVDIR    -> AGENT_SANDBOX_ENVDIR
#   OPENCODE_SANDBOX_WORKSPACE -> AGENT_SANDBOX_WORKSPACE
set -euo pipefail
HERE="$(dirname "$(readlink -f "$0")")"
for c in "$HERE/agent-sandbox-launch" /workspace/igou-devenv/.devcontainer/agent-sandbox-launch; do
    [ -x "$c" ] && { LAUNCH="$c"; break; }
done
[ -n "${LAUNCH:-}" ] || { echo "opencode-sandbox-launch: agent-sandbox-launch not found" >&2; exit 1; }

export AGENT_SANDBOX_PROFILES="${AGENT_SANDBOX_PROFILES:-${OPENCODE_SANDBOX_PROFILE:-none}}"
[ -n "${OPENCODE_SANDBOX_IMAGE:-}" ]     && export AGENT_SANDBOX_IMAGE="${AGENT_SANDBOX_IMAGE:-$OPENCODE_SANDBOX_IMAGE}"
[ -n "${OPENCODE_SANDBOX_ENVDIR:-}" ]    && export AGENT_SANDBOX_ENVDIR="${AGENT_SANDBOX_ENVDIR:-$OPENCODE_SANDBOX_ENVDIR}"
[ -n "${OPENCODE_SANDBOX_WORKSPACE:-}" ] && export AGENT_SANDBOX_WORKSPACE="${AGENT_SANDBOX_WORKSPACE:-$OPENCODE_SANDBOX_WORKSPACE}"

ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --profile) export AGENT_SANDBOX_PROFILES="$2"; shift 2 ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
exec "$LAUNCH" --driver opencode "${ARGS[@]}"
