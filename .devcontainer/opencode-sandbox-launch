#!/usr/bin/env bash
# shellcheck disable=SC2011,SC2054
# Launch opencode inside a hardened rootless podman container for use as an
# ADDITIONAL t3 provider instance (it does NOT replace the default opencode).
#
# t3 invokes this as the instance's binaryPath, e.g.
#   opencode-sandbox-launch serve --hostname=127.0.0.1 --port=NNNN
# and also for probes (--version, agent list, models --verbose). Every opencode
# argument is forwarded verbatim to opencode inside the container.
#
# Credentials: the container never mounts ~/.config/op (no 1Password). Instead,
# the profile named by $OPENCODE_SANDBOX_PROFILE (an envs/<profile>.env file) is
# resolved on the host via `op inject` at launch and injected as -e KEY=VALUE.
# The t3 provider instance selects the profile through its own `environment`,
# e.g. OPENCODE_SANDBOX_PROFILE=ocp-cluster-reader for a read-only kubeconfig.
# Default profile "none" injects nothing.
#
# All diagnostics go to stderr so t3's stdout parsing (version string and the
# "opencode server listening on <url>" ready line) stays clean.
#
# See adr/0005-opencode-1password-sandbox.md.
set -euo pipefail

log() { echo "opencode-sandbox-launch: $*" >&2; }

IMAGE="${OPENCODE_SANDBOX_IMAGE:-ghcr.io/igou-io/opencode:latest}"
ENVDIR="${OPENCODE_SANDBOX_ENVDIR:-/workspace/igou-devenv/envs}"
PROFILE="${OPENCODE_SANDBOX_PROFILE:-none}"
WORKSPACE_MOUNT="${OPENCODE_SANDBOX_WORKSPACE:-/workspace}"
DRY_RUN=false

# Leading launcher-only flags; everything else is forwarded to opencode.
OPENCODE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --dry-run) DRY_RUN=true; shift ;;
        --profile) PROFILE="$2"; shift 2 ;;
        --) shift; OPENCODE_ARGS+=("$@"); break ;;
        *)  OPENCODE_ARGS+=("$1"); shift ;;
    esac
done

# ---------------------------------------------------------------------------
# Resolve the profile's credentials on the host (op stays out of the container)
# ---------------------------------------------------------------------------
ENV_ARGS=()
TMPFILES=()
cleanup() { for f in "${TMPFILES[@]:-}"; do [ -n "$f" ] && rm -f "$f"; done; }
trap cleanup EXIT

if [ "$PROFILE" != "none" ] && [ -n "$PROFILE" ]; then
    envfile="${ENVDIR}/${PROFILE}.env"
    if [ ! -f "$envfile" ]; then
        log "profile '$PROFILE' not found ($envfile)"
        log "available: $(ls "${ENVDIR}"/*.env 2>/dev/null | xargs -n1 basename 2>/dev/null | sed 's/\.env$//' | tr '\n' ' ')"
        exit 1
    fi

    # op runs in Connect mode from files when no OP_* env is set (t3 carries
    # none). Export the token the way ~/.bashrc does so `op inject` can resolve.
    if [ -z "${OP_CONNECT_TOKEN:-}" ] && [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] \
       && [ -f "$HOME/.config/op/connect-host" ] && [ -f "$HOME/.config/op/connect-token" ]; then
        OP_CONNECT_HOST="$(cat "$HOME/.config/op/connect-host")"; export OP_CONNECT_HOST
        OP_CONNECT_TOKEN="$(cat "$HOME/.config/op/connect-token")"; export OP_CONNECT_TOKEN
    fi

    kubeconfig_ref=$(grep '^KUBECONFIG_DATA=' "$envfile" | head -1 | cut -d= -f2- || true)
    kubeconfig_token_ref=$(grep '^KUBECONFIG_TOKEN=' "$envfile" | head -1 | cut -d= -f2- || true)
    kubeconfig_host_ref=$(grep '^KUBECONFIG_HOST=' "$envfile" | head -1 | cut -d= -f2- || true)

    if [ -n "$kubeconfig_ref" ] && { [ -n "$kubeconfig_token_ref" ] || [ -n "$kubeconfig_host_ref" ]; }; then
        log "profile '$PROFILE' has both KUBECONFIG_DATA and KUBECONFIG_TOKEN/HOST — use one"
        exit 1
    fi
    if { [ -n "$kubeconfig_token_ref" ] && [ -z "$kubeconfig_host_ref" ]; } || \
       { [ -z "$kubeconfig_token_ref" ] && [ -n "$kubeconfig_host_ref" ]; }; then
        log "profile '$PROFILE' must set both KUBECONFIG_TOKEN and KUBECONFIG_HOST"
        exit 1
    fi

    remaining=$(grep -v '^KUBECONFIG_DATA=\|^KUBECONFIG_TOKEN=\|^KUBECONFIG_HOST=' "$envfile" || true)
    if [ -n "$remaining" ]; then
        resolved=$(echo "$remaining" | op inject) || { log "op inject failed for '$PROFILE'"; exit 1; }
        while IFS= read -r line; do
            [[ -z "$line" || "$line" == \#* ]] && continue
            ENV_ARGS+=("-e" "$line")
        done <<< "$resolved"
    fi

    if [ -n "$kubeconfig_ref" ]; then
        tmpkube=$(mktemp /tmp/kubeconfig.XXXXXX); TMPFILES+=("$tmpkube")
        op read "$kubeconfig_ref" | base64 -d > "$tmpkube"
        ENV_ARGS+=("-e" "KUBECONFIG=/tmp/kubeconfig")
    elif [ -n "$kubeconfig_token_ref" ]; then
        tmpkube=$(mktemp /tmp/kubeconfig.XXXXXX); TMPFILES+=("$tmpkube")
        kube_token=$(echo "$kubeconfig_token_ref" | op inject)
        kube_host=$(echo "$kubeconfig_host_ref" | op inject)
        cat > "$tmpkube" << KUBECFG
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: ${kube_host}
    insecure-skip-tls-verify: true
  name: cluster
contexts:
- context:
    cluster: cluster
    user: user
  name: context
current-context: context
users:
- name: user
  user:
    token: ${kube_token}
KUBECFG
        ENV_ARGS+=("-e" "KUBECONFIG=/tmp/kubeconfig")
    fi
fi

# ---------------------------------------------------------------------------
# Build the hardened podman run arguments (mirrors bin/opencode-run)
# ---------------------------------------------------------------------------
RUN_ARGS=(
    --rm
    --replace
    --name "opencode-instance-${PROFILE}"
    --userns=keep-id
    # Host networking so opencode's `serve` listener is reachable by t3 at the
    # 127.0.0.1:PORT it prints, with no port-publish plumbing.
    --network=host
    --cap-drop=ALL
    --security-opt no-new-privileges:true
    --tmpfs /tmp:rw,noexec,nosuid,size=256m
    --tmpfs /run:rw,noexec,nosuid,size=64m
    --cpus=2
    --pids-limit=512
    --ulimit nofile=1024:2048
    --ulimit nproc=512:512
    --ulimit core=0
)
if command -v catatonit &>/dev/null || [ -x /usr/libexec/podman/catatonit ]; then
    RUN_ARGS+=(--init)
fi

# Workspace at the same absolute path so opencode's path-keyed project state
# matches devcontainer sessions. NO ~/.config/op mount — that is the point.
RUN_ARGS+=(-v "${WORKSPACE_MOUNT}:${WORKSPACE_MOUNT}:Z" -w "${WORKSPACE_MOUNT}")

OPENCODE_CONFIG="${OPENCODE_CONFIG:-$HOME/.config/opencode}"
OPENCODE_STATE="${OPENCODE_STATE:-$HOME/.local/share/opencode}"
mkdir -p "$OPENCODE_CONFIG" "$OPENCODE_STATE"
RUN_ARGS+=(-v "$OPENCODE_CONFIG:/home/igou/.config/opencode:Z")
RUN_ARGS+=(-v "$OPENCODE_STATE:/home/igou/.local/share/opencode:Z")

for f in "${TMPFILES[@]:-}"; do
    [ -n "$f" ] && RUN_ARGS+=(-v "$f:/tmp/kubeconfig:ro,Z")
done
if [ ${#ENV_ARGS[@]} -gt 0 ]; then
    RUN_ARGS+=("${ENV_ARGS[@]}")
fi

CMD=("$IMAGE" opencode "${OPENCODE_ARGS[@]:-}")

# ---------------------------------------------------------------------------
# Launch (or print, for tests). Only opencode's own output reaches stdout.
# ---------------------------------------------------------------------------
if $DRY_RUN; then
    printf "podman run"
    printf " %q" "${RUN_ARGS[@]}"
    printf " %q" "${CMD[@]}"
    echo
    exit 0
fi

if ! podman image exists "$IMAGE" 2>/dev/null; then
    log "pulling $IMAGE ..."
    podman pull "$IMAGE" >&2 || { log "failed to pull $IMAGE"; exit 1; }
fi

exec podman run "${RUN_ARGS[@]}" "${CMD[@]}"
