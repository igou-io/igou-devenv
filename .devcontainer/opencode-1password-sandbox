#!/bin/sh
# opencode 1Password sandbox shim.
#
# Baked into the image and installed as ~/.local/bin/opencode (the first
# "opencode" on PATH), so every opencode invocation — including the servers t3
# spawns — runs through here. It executes the real binary inside a private mount
# namespace with a tmpfs masking ~/.config/op, so no agent command can read the
# 1Password Connect token (or the service-account-token fallback). Without those
# files ~/.bashrc exports no OP_CONNECT_*/OP_SERVICE_ACCOUNT_TOKEN and `op`
# cannot authenticate — see adr/0005-opencode-1password-sandbox.md.
#
# Fail-closed: if the namespace or mask cannot be created, opencode does not run.
#
# The setpriv CAP_SYS_ADMIN drop is load-bearing: inside the namespace the
# process is root and could otherwise `umount` the tmpfs (or nest a fresh user
# namespace) to re-expose the underlying token. Dropping the capability from the
# bounding set blocks both.
REAL="$HOME/.opencode/bin/opencode"

# The inner script is single-quoted on purpose: $HOME/$0/$@ must expand inside
# the namespaced shell, not here.
# shellcheck disable=SC2016
exec unshare --mount --map-root-user /bin/sh -c '
  if [ -d "$HOME/.config/op" ]; then
    mount -t tmpfs tmpfs "$HOME/.config/op" || exit 97
  fi
  exec setpriv --bounding-set -sys_admin "$0" "$@"
' "$REAL" "$@"
