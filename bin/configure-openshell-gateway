#!/usr/bin/env bash
# Converge non-secret OpenShell gateway metadata without touching login tokens.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
SOURCE="$REPO_DIR/dotfiles/openshell/gateways/ocp/metadata.json"
CONFIG_ROOT="${OPENSHELL_CONFIG_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/openshell}"
GATEWAY_DIR="$CONFIG_ROOT/gateways/ocp"

install -d -m 0700 "$GATEWAY_DIR"
install -m 0644 "$SOURCE" "$GATEWAY_DIR/metadata.json"
